{
	"name": "rentbikehanoi/wp-theme",
	"description": "Development tooling only (coding standards). Not shipped in the theme or plugin ZIP.",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint:plugin": "phpcs --standard=phpcs-plugin.xml.dist",
		"lint:compat": "phpcs --standard=phpcs.xml.dist ."
	}
}
